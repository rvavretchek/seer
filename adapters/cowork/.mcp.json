{
  "mcpServers": {
    "openalex-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/openalex-mcp-server"],
      "env": {
        "OPENALEX_API_KEY": "${OPENALEX_API_KEY}"
      }
    },
    "ibge-br-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "ibge-br-mcp"]
    }
  }
}
